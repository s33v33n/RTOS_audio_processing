# ------------------------------------------------------------------
# Code generated by STM32CubeMX from RTOS_audio.ioc
# (restore with: open .ioc -> Generate Code)
# ------------------------------------------------------------------
Drivers/
Core/Startup/

# Core: keep only files with application code in USER CODE sections
Core/Inc/*
!Core/Inc/main.h
Core/Src/*
!Core/Src/main.c
!Core/Src/freertos.c

# Middlewares: FreeRTOS is generated, ST libs (PDM2PCM, CMSIS-DSP) are added manually -> keep
Middlewares/*
!Middlewares/ST/

# Linker scripts and CubeMX metadata (generated)
*.ld
.mxproject

# ------------------------------------------------------------------
# STM32CubeIDE / Eclipse
# ------------------------------------------------------------------
Debug/
Release/
.metadata/
.settings/
*.launch
*.epf

# Build output
*.o
*.d
*.su
*.cyclo
*.elf
*.hex
*.bin
*.map
*.list

# ------------------------------------------------------------------
# Local docs and old tools (datasheets are linked in README)
# ------------------------------------------------------------------
Docs/
SerialPlot/

# ------------------------------------------------------------------
# Python (FFT viewer)
# ------------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/

# ------------------------------------------------------------------
# Editors, OS, temp files
# ------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
*.orig
*.bak
*.zip
